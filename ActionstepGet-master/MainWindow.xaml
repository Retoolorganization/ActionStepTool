<Window x:Class="ActionstepGet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mdwpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="Actionstep REST Client"
        Width="700"
        Height="820"
        MinWidth="500"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2">

    <Window.Resources>
        <SolidColorBrush x:Key="HeaderPurple" Color="#6B46C1" />

        <Style x:Key="SpartanGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource HeaderPurple}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource HeaderPurple}"
                                    CornerRadius="6,6,0,0"
                                    Padding="10,8"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Stretch" />
                            </Border>

                            <Border Grid.Row="1"
                                    Background="White"
                                    CornerRadius="0,0,6,6"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderFormatTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                BorderBrush="#E4D9FF"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="White" />
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="White" />
                                <Setter Property="Foreground" Value="#6B46C1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#FFC107" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <mdwpf:Card Padding="14" Margin="0,0,0,12">
            <GroupBox Style="{StaticResource SpartanGroupBox}">
                <GroupBox.Header>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Margin="12,0,0,0">

                            <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                <TabControl ItemsSource="{Binding Environments}"
                                            SelectedIndex="{Binding SelectedEnvironmentIndex, Mode=TwoWay}"
                                            ItemContainerStyle="{StaticResource HeaderFormatTab}"
                                            IsEnabled="{Binding IsIdle}">
                                    <TabControl.Template>
                                        <ControlTemplate TargetType="TabControl">
                                            <TabPanel IsItemsHost="True" />
                                        </ControlTemplate>
                                    </TabControl.Template>
                                    <TabControl.Style>
                                        <Style TargetType="TabControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TabControl.Style>
                                </TabControl>

                                <TextBlock Text="{Binding SelectedEnvironment}"
                                           Foreground="White"
                                           FontSize="12"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthed}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <mdwpf:PackIcon Width="22"
                                            Height="22"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                <mdwpf:PackIcon.Style>
                                    <Style TargetType="mdwpf:PackIcon">
                                        <Setter Property="Kind" Value="CloseCircle" />
                                        <Setter Property="Foreground" Value="#FF8A80" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAuthed}" Value="True">
                                                <Setter Property="Kind" Value="CheckCircle" />
                                                <Setter Property="Foreground" Value="#69F0AE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </mdwpf:PackIcon.Style>
                            </mdwpf:PackIcon>

                            <Button Content="{Binding AuthButtonText}"
                                    Click="Auth_Click"
                                    IsEnabled="{Binding IsIdle}"
                                    Style="{StaticResource HeaderActionButton}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource HeaderTitleText}"
                                   Text="Request" />
                    </DockPanel>
                </GroupBox.Header>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox ItemsSource="{Binding RequestMethods}"
                                  SelectedItem="{Binding RequestMethod, Mode=TwoWay}"
                                  IsEnabled="{Binding IsIdle}"
                                  MinWidth="78"
                                  MinHeight="36"
                                  VerticalAlignment="Top"
                                  ToolTip="HTTP method" />

                        <TextBox Grid.Column="2"
                                 Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsIdle}"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 MinHeight="100"
                                 MaxHeight="180"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderBrush="#CFCFCF"
                                 BorderThickness="1"
                                 Background="White"
                                 Style="{x:Null}"
                                 ToolTip="Enter an Actionstep REST path. Line breaks are ignored when sending." />
                    </Grid>

                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPostRequest}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="POST body (JSON)"
                                   Foreground="#555"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5" />

                        <TextBox Text="{Binding RequestBody, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsIdle}"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 MinHeight="100"
                                 MaxHeight="160"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderBrush="#CFCFCF"
                                 BorderThickness="1"
                                 Background="White"
                                 Style="{x:Null}"
                                 ToolTip="Enter a valid JSON request body. Actionstep REST requests use JSON:API." />
                    </StackPanel>

                    <DockPanel LastChildFill="True" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="Run"
                                Click="Run_Click"
                                IsEnabled="{Binding CanRun}"
                                Height="36"
                                MinWidth="80"
                                Margin="12,0,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                        <CheckBox Content="Fetch all pages"
                                  IsChecked="{Binding FetchAllPages}"
                                  IsEnabled="{Binding CanFetchAllPages}"
                                  VerticalAlignment="Center"
                                  ToolTip="GET only: follow subsequent pages and retain responses in pages[]." />
                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </mdwpf:Card>

        <mdwpf:Card Grid.Row="1" Padding="14">
            <GroupBox Style="{StaticResource SpartanGroupBox}">
                <GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource HeaderTitleText}"
                                   Text="Response" />

                        <TabControl Grid.Column="1"
                                    SelectedIndex="{Binding SelectedFormatIndex, Mode=TwoWay}"
                                    ItemContainerStyle="{StaticResource HeaderFormatTab}"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <StackPanel Orientation="Horizontal"
                    IsItemsHost="True"
                    KeyboardNavigation.TabNavigation="Local" />
                                </ControlTemplate>
                            </TabControl.Template>

                            <TabItem Header="JSON" />
                            <TabItem Header="YAML" />
                            <TabItem Header="Table" />
                        </TabControl>

                        <Button Grid.Column="2"
                                Style="{StaticResource HeaderActionButton}"
                                Content="Copy"
                                Click="Copy_Click"
                                IsEnabled="{Binding HasOutput}" />
                    </Grid>
                </GroupBox.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="1"
                               Text="{Binding DisplayNotice}"
                               TextWrapping="Wrap"
                               Foreground="#A04B00">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DisplayNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Row="2">
                        <TextBox x:Name="JsonResponseTextBox"
                                 Text="{Binding JsonOutput, Mode=OneWay}"
                                 TextChanged="ResponseTextBox_TextChanged"
                                 IsReadOnly="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 SelectionBrush="#FFD54F"
                                 SelectionOpacity="0.35"
                                 SelectionTextBrush="Black"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFormatIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedFormatIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBox x:Name="YamlResponseTextBox"
                                 Text="{Binding YamlOutput, Mode=OneWay}"
                                 TextChanged="ResponseTextBox_TextChanged"
                                 IsReadOnly="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 SelectionBrush="#FFD54F"
                                 SelectionOpacity="0.35"
                                 SelectionTextBrush="Black"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFormatIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFormatIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TableRowCount}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Foreground="#666" />

                                <ComboBox ItemsSource="{Binding Tables}"
                                          SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          ToolTip="Response collection"
                                          MinHeight="30" />
                            </DockPanel>

                            <DataGrid x:Name="TableGrid"
                                      Grid.Row="1"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="True"
                                      SelectionUnit="Cell"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      GridLinesVisibility="Horizontal"
                                      AutoGeneratingColumn="TableGrid_AutoGeneratingColumn"
                                      Sorting="TableGrid_Sorting"
                                      PreviewMouseRightButtonDown="TableGrid_RightClick"
                                      ContextMenuOpening="TableGrid_ContextMenuOpening">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy value" Click="CopyValue_Click" />
                                        <MenuItem Header="Copy column" Click="CopyColumn_Click" />
                                        <MenuItem Header="Copy table" Click="CopyTable_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="3"
                            BorderBrush="#E5E5E5"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Find"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <TextBox x:Name="FindTextBox"
                                     Grid.Column="1"
                                     Height="30"
                                     Padding="6,3"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#CFCFCF"
                                     BorderThickness="1"
                                     Background="White"
                                     Style="{x:Null}"
                                     TextChanged="FindTextBox_TextChanged"
                                     ToolTip="Find text in the displayed response. Search ignores case." />

                            <TextBlock x:Name="FindCountText"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Margin="8,0"
                                       Foreground="#666" />

                            <Button Grid.Column="3"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Click="Find_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Search response">
                                <mdwpf:PackIcon Kind="Magnify" Width="18" Height="18" />
                            </Button>

                            <Button x:Name="FindNextButton"
                                    Grid.Column="4"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Margin="6,0,0,0"
                                    Click="FindNext_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Next match">
                                <mdwpf:PackIcon Kind="ChevronRight" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>
        </mdwpf:Card>
        <TextBlock Grid.Row="2"
           Text="{Binding StatusText}"
           Foreground="#777"
           FontSize="11"
           Margin="2,8,2,0"
           TextWrapping="Wrap" />
    </Grid>
</Window>